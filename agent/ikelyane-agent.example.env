# ikelyane-agent configuration — copy to /etc/ikelyane-agent/agent.env, fill in the values below,
# then `chmod 600` it (it holds the HMAC secret): only root and the agent's own user should read it.
#
# Get KEY_ID and SECRET by registering this host in IkelyaneMonitor (Settings > Servers > Register
# a server in the web UI, or `npm run provision:host -- --org <slug> --hostname <name>` from the
# main app). The secret is shown ONCE at registration time — store it here, it cannot be recovered.

# Base URL of your IkelyaneMonitor server (no trailing slash).
IKELYANE_SERVER_URL=https://monitor.example.com

# From the host registration screen.
IKELYANE_KEY_ID=ikm_xxxxxxxxxxxxxxxxxxxxxxxx
IKELYANE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# How often to collect and send a sample, in seconds. Optional, default 60; minimum 10.
IKELYANE_INTERVAL_SECONDS=60

# Where to queue samples that could not be sent (server unreachable). Optional, default shown below.
IKELYANE_BUFFER_DIR=/var/lib/ikelyane-agent/buffer
