# IkelyaneMonitor — variables d'environnement (MODÈLE, sans secret).
#
# Ce fichier s'appelle « env.example » (sans point) : les fichiers « .env* » sont protégés par les
# permissions de l'environnement de développement. Créez votre propre .env (jamais commité) ou
# définissez ces variables dans l'unité systemd (Environment= / EnvironmentFile=).

# Connexion PostgreSQL — TimescaleDB requis. Port 5440 = docker-compose.yml (dev).
DATABASE_URL=postgresql://ikelyane:MOT_DE_PASSE@127.0.0.1:5440/ikelyanemonitor

# Mot de passe du PostgreSQL de développement (docker compose). Générer : openssl rand -hex 24
POSTGRES_PASSWORD=

# Clé maître (32 octets en base64) qui chiffre au repos les secrets stockés en base :
# secrets HMAC des agents et identifiants SNMP. Générer : openssl rand -base64 32
# ⚠ La perdre rend ces secrets illisibles ; la changer impose de les ré-enregistrer.
IKELYANE_SECRET_KEY=

# Ingestion de télémétrie (valeurs par défaut indiquées).
TELEMETRY_MAX_CLOCK_SKEW_SECONDS=300
TELEMETRY_MAX_BODY_BYTES=1048576

# ── Authentication ──────────────────────────────────────────────────────────────────────────────
# Public base URL, used to build invitation links. Set it in production (https://monitor.example.com).
APP_BASE_URL=
# Self-service sign-up that creates a new organization. Default: false (accounts come by invitation;
# create the first owner with `npm run create:owner`).
AUTH_ALLOW_REGISTRATION=false
# Behind a reverse proxy, read the client address from the last X-Forwarded-For entry (used for
# sign-in throttling and the audit log). Keep true behind Apache/nginx; false when exposed directly.
AUTH_TRUST_PROXY_HEADERS=true
# Session cookies are Secure (and __Host- prefixed) in production. Set to false ONLY to test a
# production build over plain http on localhost.
AUTH_COOKIE_SECURE=

# ── Alert notifications (src/lib/notify/, src/modules/alerts/notify.ts) ────────────────────────
# Left unset, outgoing alert e-mail is handed to the local /usr/sbin/sendmail (works out of the box
# on this cPanel host: @ikelyane.com outgoing mail is already rewritten/DKIM-signed there — see the
# deployment notes). Set SMTP_URL on a host with no local MTA, e.g.:
# SMTP_URL=smtp://user:pass@smtp.example.com:587
SMTP_URL=
# "Display Name <address>" used as the From header of alert e-mail.
ALERTS_EMAIL_FROM=IkelyaneMonitor <noreply@ikelyane.com>
